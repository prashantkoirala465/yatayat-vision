# The API server only ever needs FastAPI/SQLAlchemy/redis-the-client, never
# the ML stack (see docs/architecture.md on why the API/worker split exists)
# - this image stays small and builds fast because of it.

FROM python:3.12-slim
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini .
COPY alembic ./alembic
COPY app ./app

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
